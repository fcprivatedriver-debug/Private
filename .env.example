# addYknow — Environment
# App brand: addYknow | Assistant: MEL
# Technical domain (temporary): addandknow.pt — do not invent a new domain here.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/db?schema=public"

AUTH_SECRET="generate-a-long-random-secret"
# Required in production — never commit a real secret
AUTH_TRUST_HOST="true"
# AUTH_URL="https://addandknow.pt"
# NEXT_PUBLIC_APP_URL="https://addandknow.pt"
# EMAIL_FROM="addYknow <no-reply@addandknow.pt>"
# RESEND_API_KEY=""
# AUTH_SKIP_EMAIL_VERIFY="false"

NEXT_PUBLIC_APP_NAME="addYknow"
# Production: keep DEMO_MODE=false (forced off when NODE_ENV/VERCEL_ENV=production)
DEMO_MODE="false"

# ——— MEL / OpenAI (server-only — never NEXT_PUBLIC_*) ———
# Already set on Vercel production. Leave empty locally to use rule-based fallback.
# OPENAI_API_KEY=""
# Economic default: gpt-4o-mini (override if needed)
# OPENAI_MODEL="gpt-4o-mini"
# Monthly MEL interactions per user (Stripe plan limits later)
# MEL_MONTHLY_LIMIT="200"

# ——— Anexos de fatura ———
# Persistência por omissão: Neon BYTEA (tabela StoredObject) — sem serviço pago extra.
# Opcional futuro: Vercel Blob (não activar automaticamente)
# BLOB_READ_WRITE_TOKEN=""
