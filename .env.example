# Tripvo environment example (PostgreSQL / Neon)

# Pooled connection used by the app at runtime (Neon "pooled" / -pooler host)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection used by Prisma Migrate (Neon "direct" host, no -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Local PostgreSQL example:
# DATABASE_URL="postgresql://tripvo:tripvo@127.0.0.1:5432/tripvo?schema=public"
# DIRECT_URL="postgresql://tripvo:tripvo@127.0.0.1:5432/tripvo?schema=public"

AUTH_SECRET="generate-a-long-random-secret"
# REQUIRED on Vercel — without AUTH_SECRET Auth.js shows:
# "Server error. There is a problem with the server configuration."
AUTH_TRUST_HOST="true"

# Optional Google OAuth
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

PAYMENTS_ENABLED="false"
PLATFORM_COMMISSION_PERCENT="5"
PLATFORM_FEE_PERCENT="5"
NEXT_PUBLIC_APP_NAME="Tripvo"

# Google Maps (Places Autocomplete + Directions for distance/duration)
# Canonical for Next.js (also inlined into the client bundle when present):
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-only aliases also accepted at runtime (useful if Vercel env was misnamed):
# GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY=
# Enable: Maps JavaScript API, Places API, Geocoding API, Directions API.
# Restrict by HTTP referrer (NEXT_PUBLIC_) and/or IP (server-only key).

# Optional later
# DEMO_MODE="true"
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CRON_SECRET=
