# Mel environment example (PostgreSQL / Neon)

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Local PostgreSQL:
# DATABASE_URL="postgresql://mel:mel@127.0.0.1:5432/mel?schema=public"
# DIRECT_URL="postgresql://mel:mel@127.0.0.1:5432/mel?schema=public"

AUTH_SECRET="generate-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Optional Google OAuth
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

NEXT_PUBLIC_APP_NAME="Mel"
DEMO_MODE="true"

# Em Neon partilhado (Vercel), a Mel usa o schema `mel` automaticamente.
# MEL_PG_SCHEMA="mel"
# FORCE_MEL_SCHEMA="true"
