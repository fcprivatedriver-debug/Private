# FC Private Driver — environment example (PostgreSQL / Neon)

# Pooled connection used by the app at runtime (Neon "pooled" / -pooler host)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection used by Prisma Migrate (Neon "direct" host, no -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Local PostgreSQL example:
# DATABASE_URL="postgresql://fcpd:fcpd@127.0.0.1:5432/fcpd?schema=public"
# DIRECT_URL="postgresql://fcpd:fcpd@127.0.0.1:5432/fcpd?schema=public"

AUTH_SECRET="generate-a-long-random-secret"
AUTH_TRUST_HOST="true"

NEXT_PUBLIC_APP_NAME="FC Private Driver"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_MODE="false"

# Payments (set PAYMENTS_ENABLED=true with real Stripe keys in production)
PAYMENTS_ENABLED="false"
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps (autocomplete + distance)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Transactional email (Resend). From address must be allowed in Resend.
# Without RESEND_API_KEY, emails are logged in demo mode (registration still creates the token).
# RESEND_API_KEY=
EMAIL_FROM="FC Private Driver <fcprivatedriver@gmail.com>"

# Optional
# CRON_SECRET=
