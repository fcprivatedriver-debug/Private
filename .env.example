# Mel environment example (PostgreSQL / Neon)

# Pooled (app runtime) — em Neon partilhada o build força schema=mel
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (Prisma Migrate) — host sem -pooler
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Local PostgreSQL (o migrate cria/usa o schema mel):
# DATABASE_URL="postgresql://mel:mel@127.0.0.1:5432/mel"
# DIRECT_URL="postgresql://mel:mel@127.0.0.1:5432/mel"

# Obrigatório em produção / Preview Vercel (32+ caracteres aleatórios reais)
AUTH_SECRET="generate-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Optional Google OAuth
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

NEXT_PUBLIC_APP_NAME="Mel"
DEMO_MODE="true"

# Schema Mel na Neon partilhada (ZRIK = public). O build também força isto.
MEL_PG_SCHEMA="mel"
# FORCE_MEL_SCHEMA="true"
