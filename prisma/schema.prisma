generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum AccountStatus {
  PENDING_EMAIL
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PaymentKind {
  SUBSCRIPTION
  EXTRA_MINUTES
  EXTRA_CHARGE
}

enum PaymentMethodType {
  CARD
  MB_WAY
  MULTIBANCO
  MANUAL
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TripStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  REASSIGNED
}

enum MinuteTxnType {
  PLAN_RENEWAL
  TRIP_COMPLETED
  EXTRA_PURCHASE
  PROMOTIONAL
  ADMIN_ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
  WAITING
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  phone         String?
  role          Role          @default(CUSTOMER)
  status        AccountStatus @default(PENDING_EMAIL)
  locale        String        @default("pt")
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts              Account[]
  sessions              Session[]
  customerProfile       CustomerProfile?
  driverProfile         DriverProfile?
  subscriptions         Subscription[]
  payments              Payment[]
  trips                 Trip[]                 @relation("CustomerTrips")
  tripAssignments       TripAssignment[]      @relation("DriverAssignments")
  minuteTransactions    MinuteTransaction[]
  notifications         Notification[]
  adminAuditLogs        AdminAuditLog[]       @relation("AuditActor")
  passwordResetTokens   PasswordResetToken[]
  emailConfirmTokens    EmailConfirmToken[]
  timerAdjustments      TripTimer[]           @relation("TimerAdjustedBy")

  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailConfirmToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  fullName          String?
  addressLine       String?
  postalCode        String?
  city              String?
  birthDate         DateTime?
  taxId             String?
  phone             String?
  altPhone          String?
  notes             String?
  profileComplete   Boolean   @default(false)
  habitsComplete    Boolean   @default(false)
  stripeCustomerId  String?
  deletionRequestedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses    Address[]
  travelHabits CustomerTravelHabit?

  @@index([taxId])
}

model CustomerTravelHabit {
  id                    String   @id @default(cuid())
  customerProfileId     String   @unique
  tripsCount            Int?
  frequencyUnit         String?
  weekdays              String   @default("[]")
  usualTimes            String?
  usualPickups          String?
  usualDestinations     String?
  oftenAirport          Boolean  @default(false)
  oftenRoundTrip        Boolean  @default(false)
  needsWaiting          Boolean  @default(false)
  travelsAlone          Boolean?
  avgPassengers         Int?
  needsChildSeat        Boolean  @default(false)
  oftenLuggage          Boolean  @default(false)
  otherPreferences      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
}

model Address {
  id                String   @id @default(cuid())
  customerProfileId String
  label             String?
  line              String
  postalCode        String?
  city              String?
  lat               Float?
  lng               Float?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
}

model DriverProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  photoUrl        String?
  phone           String?
  active          Boolean  @default(true)
  bio             String?
  documents       String   @default("[]")
  availability    String   @default("{}")
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  assignments  TripAssignment[]

  @@index([active])
}

model Vehicle {
  id           String   @id @default(cuid())
  driverId     String
  make         String
  model        String
  plate        String
  color        String?
  year         Int?
  seats        Int      @default(4)
  photoUrl     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

enum DiamondProposalStatus {
  RECEIVED
  UNDER_REVIEW
  CONTACTED
  PROPOSAL_SENT
  ACCEPTED
  REJECTED
}

model Plan {
  id              String   @id @default(cuid())
  code            String   @unique
  namePt          String
  nameEn          String
  descriptionPt   String?
  descriptionEn   String?
  /// bronze | silver | gold | diamond | custom
  tier            String   @default("custom")
  /// When false (Diamante), UI hides price and shows custom copy
  showPrice       Boolean  @default(true)
  priceCents      Int      @default(0)
  monthlyMinutes  Int      @default(0)
  equivalentHours Float?
  active          Boolean  @default(true)
  /// Public catalog vs admin-created personalised plan
  isPersonalized  Boolean  @default(false)
  sortOrder       Int      @default(0)
  featuresJson    String   @default("[]")
  ctaLabelPt      String?
  ctaLabelEn      String?
  accentColor     String?
  specialConditions String?
  internalNotes   String?
  stripePriceId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions    Subscription[]
  diamondProposals DiamondProposal[] @relation("ConvertedPlan")

  @@index([active, sortOrder])
  @@index([tier])
}

model DiamondProposal {
  id                     String                @id @default(cuid())
  name                   String
  company                String?
  email                  String
  phone                  String
  estimatedUsers         Int?
  tripsPerWeek           Int?
  usualHours             String?
  serviceZone            String?
  notes                  String?
  status                 DiamondProposalStatus @default(RECEIVED)
  adminNotes             String?
  convertedPlanId        String?
  convertedSubscriptionId String?
  convertedAt            DateTime?
  contactedAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  convertedPlan Plan? @relation("ConvertedPlan", fields: [convertedPlanId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
}


model ExtraMinutePackage {
  id             String   @id @default(cuid())
  code           String   @unique
  namePt         String
  nameEn         String
  minutes        Int
  priceCents     Int
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  stripePriceId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, sortOrder])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(PENDING_PAYMENT)
  periodStart          DateTime?
  periodEnd            DateTime?
  nextRenewalAt        DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  cancelledAt          DateTime?
  cancelledBy          String?
  autoRenew            Boolean            @default(true)
  minutesIncluded      Int                @default(0)
  minutesUsed          Int                @default(0)
  minutesReserved      Int                @default(0)
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]
  trips    Trip[]

  @@index([userId, status])
  @@index([status, nextRenewalAt])
}

model Payment {
  id                    String            @id @default(cuid())
  userId                String
  subscriptionId        String?
  kind                  PaymentKind
  amountCents           Int
  currency              String            @default("EUR")
  method                PaymentMethodType @default(OTHER)
  status                PaymentStatus     @default(PENDING)
  provider              String            @default("stripe")
  providerPaymentId     String?
  providerSessionId     String?
  mbEntity              String?
  mbReference           String?
  mbWayPhone            String?
  expiresAt             DateTime?
  paidAt                DateTime?
  refundedCents         Int               @default(0)
  invoiceUrl            String?
  receiptUrl            String?
  periodStart           DateTime?
  periodEnd             DateTime?
  extraMinutes          Int?
  rawPayload            String?
  idempotencyKey        String?           @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([providerPaymentId])
  @@index([status, createdAt])
}

model Trip {
  id                      String     @id @default(cuid())
  customerId              String
  subscriptionId          String?
  status                  TripStatus @default(AWAITING_CONFIRMATION)
  tripType                TripType   @default(ONE_WAY)
  pickupAddress           String
  pickupLat               Float?
  pickupLng               Float?
  dropoffAddress          String
  dropoffLat              Float?
  dropoffLng              Float?
  scheduledAt             DateTime
  passengers              Int        @default(1)
  luggage                 Int        @default(0)
  needsWaiting            Boolean    @default(false)
  estimatedWaitMinutes    Int?
  notes                   String?
  passengerContact        String?
  distanceMeters          Int?
  durationSeconds         Int?
  estimatedMinutes        Int?
  reservedMinutes         Int        @default(0)
  chargedMinutes          Int?
  isImmediate             Boolean    @default(false)
  cancelledReason         String?
  adminNotes              String?
  confirmedAt             DateTime?
  completedAt             DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  customer         User              @relation("CustomerTrips", fields: [customerId], references: [id], onDelete: Cascade)
  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  assignments      TripAssignment[]
  timer            TripTimer?
  extraCharges     ExtraCharge[]
  minuteTxns       MinuteTransaction[]

  @@index([customerId, status])
  @@index([status, scheduledAt])
}

model TripAssignment {
  id              String           @id @default(cuid())
  tripId          String
  driverId        String
  driverUserId    String
  status          AssignmentStatus @default(PENDING)
  assignedById    String?
  note            String?
  respondedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  trip       Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver     DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverUser User          @relation("DriverAssignments", fields: [driverUserId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
  @@index([driverUserId, status])
}

model TripTimer {
  id                  String    @id @default(cuid())
  tripId              String    @unique
  scheduledAt         DateTime?
  driverArrivedAt     DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  waitingStartedAt    DateTime?
  waitingEndedAt      DateTime?
  waitingMinutes      Int       @default(0)
  tripMinutes         Int       @default(0)
  totalMinutes        Int       @default(0)
  toleranceUsed       Boolean   @default(false)
  manualAdjustments   String    @default("[]")
  adjustedById        String?
  adjustmentReason    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  trip       Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  adjustedBy User? @relation("TimerAdjustedBy", fields: [adjustedById], references: [id], onDelete: SetNull)
}

model MinuteTransaction {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  tripId         String?
  type           MinuteTxnType
  minutes        Int
  balanceAfter   Int
  reason         String
  actorId        String?
  meta           String?
  createdAt      DateTime      @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tripId])
  @@index([type])
}

model ExtraCharge {
  id          String   @id @default(cuid())
  tripId      String
  label       String
  amountCents Int
  currency    String   @default("EUR")
  kind        String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?
  sentAt    DateTime?
  meta      String?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, readAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  reason     String?
  meta       String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

/// Editable platform settings (singleton id = "default")
model SiteSettings {
  id                      String   @id @default("default")
  brandName               String   @default("FC Private Driver")
  supportEmail            String   @default("fcprivatedriver@gmail.com")
  supportPhone            String   @default("+351 933 239 595")
  whatsappNumber          String   @default("+351933239595")
  toleranceMinutes        Int      @default(10)
  minimumChargeMinutes    Int      @default(15)
  lowBalanceThreshold     Int      @default(60)
  maxPickupDistanceKm     Float?
  serviceZonesJson        String   @default("[]")
  heroTitlePt             String   @default("O seu motorista privado, sempre que precisar.")
  heroSubtitlePt          String   @default("Escolha o seu plano mensal, marque as suas viagens e deixe o resto connosco. Sem procurar motoristas. Sem preços dinâmicos. Sem complicações.")
  heroTitleEn             String   @default("Your private driver, whenever you need.")
  heroSubtitleEn          String   @default("Choose your monthly plan, book your trips, and leave the rest with us.")
  heroImageUrl            String   @default("/brand/fc-hero.jpg")
  termsHtmlPt             String   @default("")
  termsHtmlEn             String   @default("")
  privacyHtmlPt           String   @default("")
  privacyHtmlEn           String   @default("")
  demoMode                Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}
