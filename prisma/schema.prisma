generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ——— Auth (Auth.js) ———

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  /// PIN local para desbloqueio rápido (clientes nativos / PWA)
  pinHash            String?
  /// Preferência: após o 1.º login, permitir Face ID / Touch ID / WebAuthn
  biometricsEnabled  Boolean   @default(false)
  /// Credencial WebAuthn / biometric credential id (opcional)
  biometricCredentialId String?
  theme              String    @default("system") // light | dark | system
  locale             String    @default("pt")
  timezone           String    @default("Europe/Lisbon")
  /// Tom da Mel: warm | concise | motivational
  melTone            String    @default("warm")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts       AuthAccount[]
  sessions       Session[]
  modules        UserModule[]
  tasks          Task[]
  events         CalendarEvent[]
  habits         Habit[]
  reminders      Reminder[]
  captures       VoiceCapture[]
  reports        WeeklyReport[]
  conversations  MelMessage[]
}

model AuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ——— Modularidade ———

enum ModuleId {
  TASKS
  CALENDAR
  VOICE
  REPORTS
  HABITS
  REMINDERS
}

model UserModule {
  id        String   @id @default(cuid())
  userId    String
  moduleId  ModuleId
  enabled   Boolean  @default(true)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
}

// ——— Tarefas ———

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  notes       String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  completedAt DateTime?
  source      String       @default("manual") // manual | voice | calendar
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueAt])
}

// ——— Calendário ———

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  source      String   @default("manual") // manual | voice | external
  externalId  String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
}

// ——— Hábitos (estrutura pronta) ———

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

model Habit {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  frequency   HabitFrequency @default(DAILY)
  targetPerWeek Int?
  color       String?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, active])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  doneAt    DateTime @default(now())
  note      String?

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId, doneAt])
}

// ——— Lembretes (estrutura pronta) ———

enum ReminderStatus {
  SCHEDULED
  SENT
  DISMISSED
  CANCELLED
}

model Reminder {
  id        String         @id @default(cuid())
  userId    String
  title     String
  body      String?
  remindAt  DateTime
  status    ReminderStatus @default(SCHEDULED)
  source    String         @default("manual")
  relatedTaskId  String?
  relatedEventId String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
  @@index([userId, status])
}

// ——— Captura por voz ———

enum CaptureIntent {
  TASK
  EVENT
  REMINDER
  HABIT
  NOTE
  UNKNOWN
}

model VoiceCapture {
  id           String        @id @default(cuid())
  userId       String
  transcript   String
  intent       CaptureIntent @default(UNKNOWN)
  confidence   Float         @default(0)
  resultJson   Json?
  createdEntity String?      // e.g. "task:cuid"
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ——— Relatórios semanais ———

model WeeklyReport {
  id          String   @id @default(cuid())
  userId      String
  weekStart   DateTime
  weekEnd     DateTime
  summary     String   @db.Text
  highlights  Json?
  metrics     Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

// ——— Conversação com a Mel ———

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model MelMessage {
  id        String      @id @default(cuid())
  userId    String
  role      MessageRole
  content   String      @db.Text
  meta      Json?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
